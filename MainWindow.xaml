<Window x:Class="dLab.General.ElementsReport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:dLab.General.ElementsReport.Converters"
        xmlns:lang="clr-namespace:dLab.General.ElementsReport.Lang"
        xmlns:viewModels="clr-namespace:dLab.General.ElementsReport.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainWindowVm}"
        Title="{x:Static lang:ElementsReport.WindowTitle}"
        Height="480" Width="580"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ElementsReport;component/Views/Style/ElementsReportStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid Margin="12" Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource Heading1}"
                   Text="{x:Static lang:ElementsReport.ElementsHeading}"
                   Margin="0,0,0,10" />

        <!-- Выпадающий список категорий -->
        <ComboBox Grid.Row="1"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory}"
                  DisplayMemberPath="DisplayName"
                  Margin="0,0,0,10"
                  Height="28" />

        <!-- Сообщение об ошибке -->
        <TextBlock Grid.Row="2"
                   Style="{StaticResource DangerText}"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"
                   Margin="0,0,0,10" />

        <!-- Таблица элементов -->
        <DataGrid Grid.Row="3"
                  Style="{StaticResource ReportGrid}"
                  ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static lang:ElementsReport.TypeColumn}"
                                    Binding="{Binding Name}"
                                    Width="*" />
                <DataGridTextColumn Header="{x:Static lang:ElementsReport.LevelColumn}"
                                    Binding="{Binding LevelName}"
                                    Width="120" />
                <DataGridTextColumn Header="{x:Static lang:ElementsReport.AreaColumn}"
                                    Binding="{Binding AreaSqM, StringFormat=N2}"
                                    Width="120" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Итоговая площадь -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Caption}"
                       Text="{x:Static lang:ElementsReport.TotalLabel}"
                       Margin="0,0,8,0" />
            <TextBlock Style="{StaticResource Body}"
                       Text="{Binding TotalArea, StringFormat=N2}" />
            <TextBlock Style="{StaticResource Body}"
                       Text="{x:Static lang:ElementsReport.SquareMetersSuffix}"
                       Margin="4,0,0,0" />
        </StackPanel>
    </Grid>
</Window>